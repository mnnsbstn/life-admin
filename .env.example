# Data source: mock | supabase (local default: mock)
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (publishable / anon key only — never service_role here)
# Required when NEXT_PUBLIC_DATA_SOURCE=supabase (also set on Vercel/Hostinger)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# See docs/DEPLOYMENT.md for production Supabase redirect URLs (/auth/callback)
