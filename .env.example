# Data source: mock | supabase (local default: mock)
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (publishable / anon key only — never service_role here)
# Required when NEXT_PUBLIC_DATA_SOURCE=supabase (also set on Vercel/Hostinger)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional on Vercel (server-only, overrides NEXT_PUBLIC for Auth/DB):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# See docs/DEPLOYMENT.md for production Supabase redirect URLs (/auth/callback)

# Optional: Resend for household invitation emails (docs/INVITATION_EMAIL.md)
# RESEND_API_KEY=
# INVITATION_EMAIL_FROM=Life Admin <onboarding@resend.dev>
# LIFE_ADMIN_APP_ORIGIN=https://your-production-url.vercel.app

# Optional: Smart Capture LLM (docs/SMART_CAPTURE.md) — ohne Key läuft Heuristik
# SMART_CAPTURE_API_KEY=
# SMART_CAPTURE_MODEL=gpt-4o-mini
# SMART_CAPTURE_API_URL=https://api.openai.com/v1

# Optional: signed calendar subscribe URL (docs/CALENDAR_EMAIL.md)
# CALENDAR_FEED_SIGNING_SECRET=
# Supabase only (server route, never NEXT_PUBLIC): SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (docs/GOOGLE_CALENDAR_OAUTH.md)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_OAUTH_STATE_SECRET=
